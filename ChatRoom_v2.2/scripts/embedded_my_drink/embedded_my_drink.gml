/// @function base64_decode_buffer(b64)
/// @description 将 base64 字符串解码到二进制 buffer（使用运行时内置解码器）
function base64_decode_buffer(b64) {
    if (b64 == "") return -1;

    // 之前的逐字符解码会在打开“更多信息”时卡住数秒；
    // buffer_base64_decode 由运行时用 C++ 完成，几乎瞬间返回。
    var buf = buffer_base64_decode(b64);
    if (buf == -1) return -1;
    buffer_seek(buf, buffer_seek_start, 0);
    return buf;
}

/// @function load_embedded_my_drink()
/// @description 解码 base64、写到临时文件并加载为 sprite
function load_embedded_my_drink() {
    var b64 = embedded_my_drink_base64();
    var buf = base64_decode_buffer(b64);
    if (buf == -1) return -1;

    var dir = temp_directory;
    var sep = (string_char_at(dir, string_length(dir)) == "\\") ? "" : "\\";
    var path = dir + sep + "chatroom_my_drink_embedded.png";
    buffer_save(buf, path);
    buffer_delete(buf);

    var spr = sprite_add(path, 1, false, false, 0, 0);
    if (file_exists(path)) {
        file_delete(path);
    }
    return spr;
}
